# Save as /etc/enclave/backup.env with permissions 0600, outside Git.
# The organization owns the separate Spaces bucket and its access key.
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_REGION.digitaloceanspaces.com/REPLACE_WITH_BUCKET/enclave
RESTIC_PASSWORD_FILE=/etc/enclave/restic-password
AWS_ACCESS_KEY_ID=REPLACE_WITH_ORGANIZATION_SPACES_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_ORGANIZATION_SPACES_SECRET_KEY
