[Unit]
Description=Check Liberator backup freshness, public API and search
After=docker.service network-online.target
Wants=network-online.target
OnFailure=enclave-backup-notify@%n.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/enclave-backup/production-backup.env
StateDirectory=enclave-monitor
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/lib/enclave-operations/monitor.py
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
