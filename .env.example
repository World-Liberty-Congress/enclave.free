# ===========================================
# enclave.free-prototype Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -----------------------------------------
# API Keys (REQUIRED)
# -----------------------------------------
# Hard-cut Sage experiment:
# - Python remains the product/control plane
# - Sage owns the public AI routes
# - Tinfoil provides the LLM backend through the supported standalone proxy
LLM_PROVIDER=sage
LLM_API_KEY=your-tinfoil-api-key-here
TINFOIL_MODEL=glm-5-3-flash
# GLM-5.3 Flash supports low, high, and max thinking budgets.
# Use low for interactive conversations; GLM-5.2's none setting is not portable.
TINFOIL_REASONING_EFFORT=low
TINFOIL_EMBEDDING_MODEL=nomic-embed-text
# Optional: retry Conversation requests through Maple on Tinfoil HTTP 401/403/429.
# Enable the maple Compose profile and supply a Maple key. The model stays unchanged.
MAPLE_API_KEY=
MAPLE_API_URL=http://maple-proxy:8080/v1
# The Compose proxy pins this router enclave by default while preserving the
# internal http://tinfoil-proxy:8089/v1 contract used by Sage and Python.
TINFOIL_ROUTER_HOST=inference.tinfoil.sh
TINFOIL_ROUTER_REPO=tinfoilsh/confidential-model-router
LLM_API_URL=http://tinfoil-proxy:8089/v1
INTERNAL_AGENT_TOKEN=replace-this-with-a-random-shared-secret

# -----------------------------------------
# Active Content Storage Confidentiality
# -----------------------------------------
# Optional by default. Leave blank for local smoke tests that use plaintext
# active content, or set a stable random value to encrypt uploaded artifacts
# and retrieval chunk text.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
CONTENT_ENCRYPTION_KEY=

# Use "auto" to encrypt when CONTENT_ENCRYPTION_KEY is set and allow plaintext
# when it is blank. Use "required" to reject plaintext writes, or "disabled" to
# force plaintext active content storage.
DOCUMENT_ARTIFACT_ENCRYPTION=auto

# -----------------------------------------
# Email Configuration (REQUIRED for production)
# -----------------------------------------
# For development, leave MOCK_EMAIL=true or SMTP_HOST empty
# Magic links will be logged to console instead of sent
#
# For production, set MOCK_EMAIL=false and configure SMTP
# See docs/email-auth.md for detailed provider setup

MOCK_EMAIL=true
SMTP_PORT=587
# SMTP_TIMEOUT=10  # Connection timeout in seconds (default: 10)

# --- Choose ONE provider below and uncomment ---

# Gmail (requires App Password from myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=Sanctum <yourname@gmail.com>

# Mailgun
# SMTP_HOST=smtp.mailgun.org
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASS=your-mailgun-smtp-password
# SMTP_FROM=Sanctum <noreply@mg.yourdomain.com>

# SendGrid (SMTP_USER is literally "apikey")
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key
# SMTP_FROM=Sanctum <noreply@yourdomain.com>

# Amazon SES (use your region, FROM must be verified)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_USER=your-ses-smtp-username
# SMTP_PASS=your-ses-smtp-password
# SMTP_FROM=Sanctum <noreply@yourdomain.com>

# Postmark (user and pass are both your Server API Token)
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_USER=your-server-api-token
# SMTP_PASS=your-server-api-token
# SMTP_FROM=Sanctum <noreply@yourdomain.com>

# Brevo (formerly Sendinblue)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_USER=your-brevo-login-email
# SMTP_PASS=your-smtp-key
# SMTP_FROM=Sanctum <noreply@yourdomain.com>

# -----------------------------------------
# Frontend URL (REQUIRED for production)
# -----------------------------------------
# Used for magic link URLs, cookie origin checks, and Sage CSRF validation.
# For production, set this to your public frontend origin, e.g. https://yourdomain.com.
FRONTEND_URL=http://localhost:5173

# Optional comma-separated CORS allowlist for the API/gateway
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------
# Security (REQUIRED)
# -----------------------------------------
# Set ENCLAVE_ENV=production for internet-exposed deployments so production
# guardrails fail validation on development shortcuts.
ENCLAVE_ENV=development

# Required by Compose for both the Python backend and Sage runtime.
# Use a long random value and keep it stable across restarts.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-this-with-a-long-random-secret

# Shared rate limiting store. Compose runs a self-hosted Valkey container; no
# external account, API key, or managed service is required. Use memory only for
# single-process local development.
RATE_LIMIT_BACKEND=valkey
RATE_LIMIT_VALKEY_URL=redis://valkey:6379/0
# For a reverse-proxied backend, replace with the API gateway's exact peer IP.
FORWARDED_ALLOW_IPS=127.0.0.1

# Machine-only token for external scheduled retention automation.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Store in deployment secrets and rotate by replacing the value and redeploying.
# RETENTION_AUTOMATION_TOKEN=replace-this-with-a-long-random-automation-token

# -----------------------------------------
# Optional: Embedding Model
# -----------------------------------------
# Document embeddings default to Tinfoil through the local OpenAI-compatible proxy.
EMBEDDING_PROVIDER=tinfoil
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_URL=http://tinfoil-proxy:8089/v1
# Defaults to LLM_API_KEY when unset.
# EMBEDDING_API_KEY=your-tinfoil-api-key-here
#
# For local sentence-transformers embeddings instead:
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=intfloat/multilingual-e5-base

# -----------------------------------------
# Optional: Development/Testing
# -----------------------------------------
# ⚠️  WARNING: NEVER enable in production - bypasses authentication!
# SIMULATE_USER_AUTH bypasses magic link verification
# SIMULATE_ADMIN_AUTH shows mock Nostr button (grants admin UI access)
# See docs/authentication.md for testing workflows
# SIMULATE_USER_AUTH=true
# SIMULATE_ADMIN_AUTH=true
# BACKEND_RELOAD=true
