# Copy to a private .env outside Git. Never reuse personal account credentials.
LIBERATOR_RELEASE=production-rehearsal-1
LIBERATOR_REVISION=REPLACE_WITH_FULL_ENCLAVE_COMMIT
LIBERATOR_IMAGE_PREFIX=liberator
# Keep application data outside versioned release checkouts for rollback.
LIBERATOR_UPLOADS_DIR=/srv/liberator/uploads
ENCLAVE_ENV=production
FRONTEND_URL=https://REPLACE_WITH_ORGANIZATION_DOMAIN
LLM_PROVIDER=sage
LLM_API_KEY=REPLACE_WITH_ORGANIZATION_TINFOIL_KEY
TINFOIL_MODEL=deepseek-v4-1-flash
TINFOIL_REASONING_EFFORT=low
EMBEDDING_PROVIDER=tinfoil
EMBEDDING_MODEL=nomic-embed-text
TINFOIL_EMBEDDING_MODEL=nomic-embed-text
MAPLE_API_KEY=REPLACE_WITH_ORGANIZATION_MAPLE_KEY
SECRET_KEY=REPLACE_WITH_FRESH_RANDOM_SECRET
INTERNAL_AGENT_TOKEN=REPLACE_WITH_FRESH_RANDOM_SECRET
CONTENT_ENCRYPTION_KEY=REPLACE_WITH_FRESH_RANDOM_SECRET
DOCUMENT_ARTIFACT_ENCRYPTION=required
# Generate a hexadecimal password so it is safe in the Postgres connection URL.
POSTGRES_PASSWORD=REPLACE_WITH_FRESH_RANDOM_HEX_PASSWORD
MOCK_EMAIL=false
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=2525
SMTP_USER=REPLACE_WITH_ORGANIZATION_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_ORGANIZATION_SMTP_PASSWORD
SMTP_FROM=Liberator <REPLACE_WITH_VERIFIED_SENDER>
